{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixo.local/protocol/v1/content/words.schema.json",
  "title": "words.yaml: the reference words",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "text",
      "unit",
      "image",
      "accepted"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "text": {
        "type": "string",
        "minLength": 1
      },
      "unit": {
        "type": "string",
        "pattern": "^u[1-9][0-9]*$"
      },
      "image": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "accepted": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 3,
        "maxItems": 5,
        "uniqueItems": true
      }
    }
  }
}
