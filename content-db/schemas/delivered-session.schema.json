{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixo.app/schemas/delivered-session.schema.json",
  "title": "Séance livrée (format moteur, contrat v0.5 de Viven + ajouts d'emna)",
  "description": "Le fichier autonome que le moteur reçoit. Fabriqué par la publication, jamais écrit à la main, figé une fois publié.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "position": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "program_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "unit_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^obj_[a-z0-9_-]+$"
          },
          "title": {
            "type": "string"
          },
          "framework": {
            "type": "string"
          },
          "gse_value": {
            "type": "integer"
          },
          "skill": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "framework",
          "gse_value",
          "skill"
        ]
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^w_[a-z0-9_-]+$"
          },
          "word": {
            "type": "string"
          },
          "uri": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "vocabulary",
              "chunk"
            ]
          },
          "accepted_variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "match": {
            "enum": [
              "exact",
              "starts_with"
            ]
          }
        },
        "required": [
          "id",
          "word",
          "uri",
          "type",
          "accepted_variants"
        ]
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/greeting"
          },
          {
            "$ref": "#/$defs/present"
          },
          {
            "$ref": "#/$defs/repeat"
          },
          {
            "$ref": "#/$defs/touch"
          },
          {
            "$ref": "#/$defs/visual_description"
          },
          {
            "$ref": "#/$defs/review"
          },
          {
            "$ref": "#/$defs/sing_with_me"
          },
          {
            "$ref": "#/$defs/watch_video"
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "version",
    "position",
    "title",
    "program_id",
    "module_id",
    "unit_id",
    "objectives",
    "words",
    "activities"
  ],
  "$defs": {
    "greeting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "routine"
        },
        "type": {
          "const": "greeting"
        },
        "moment": {
          "enum": [
            "hello",
            "bye"
          ]
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "moment"
      ]
    },
    "present": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "teaching"
        },
        "type": {
          "const": "present"
        },
        "word_id": {
          "type": "string",
          "pattern": "^w_[a-z0-9_-]+$"
        },
        "say_times": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "word_id",
        "say_times"
      ]
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "exercise"
        },
        "type": {
          "const": "repeat"
        },
        "word_id": {
          "type": "string",
          "pattern": "^w_[a-z0-9_-]+$"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retry_activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "success_celebration": {
          "type": "string"
        },
        "response_timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "word_id",
        "response_timeout",
        "score",
        "max_attempts",
        "retry_activity_ids"
      ]
    },
    "touch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "exercise"
        },
        "type": {
          "const": "touch"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retry_activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "success_celebration": {
          "type": "string"
        },
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "uri": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "uri"
            ]
          }
        },
        "correct_label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "images",
        "correct_label",
        "score",
        "max_attempts",
        "retry_activity_ids"
      ]
    },
    "visual_description": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "exercise"
        },
        "type": {
          "const": "visual_description"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retry_activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "success_celebration": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "expected_word_id": {
          "type": "string",
          "pattern": "^w_[a-z0-9_-]+$"
        },
        "response_timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "uri",
        "expected_word_id",
        "response_timeout",
        "score",
        "max_attempts",
        "retry_activity_ids"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "exercise"
        },
        "type": {
          "const": "review"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retry_activity_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          }
        },
        "success_celebration": {
          "type": "string"
        },
        "review_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "review_activity_type": {
          "enum": [
            "repeat",
            "touch"
          ]
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "review_count",
        "review_activity_type",
        "score",
        "max_attempts",
        "retry_activity_ids"
      ]
    },
    "sing_with_me": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "reward"
        },
        "type": {
          "const": "sing_with_me"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "media_uri": {
          "type": "string"
        },
        "lyrics": {
          "type": "string"
        },
        "timestamps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start_ms": {
                "type": "integer"
              },
              "end_ms": {
                "type": "integer"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "start_ms",
              "end_ms",
              "text"
            ]
          }
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "media_uri",
        "lyrics",
        "timestamps"
      ]
    },
    "watch_video": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "execution_mode": {
          "enum": [
            "normal",
            "retry_only"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "const": "reward"
        },
        "type": {
          "const": "watch_video"
        },
        "score": {
          "type": "integer",
          "minimum": 0
        },
        "media_uri": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "position",
        "category",
        "type",
        "execution_mode",
        "instruction",
        "media_uri"
      ]
    }
  }
}
