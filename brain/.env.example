# Copy this file to brain/.env and fill it in. brain/.env is never committed.

# LiveKit Cloud: cloud.livekit.io > your project > Settings > Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Azure Speech: portal.azure.com > your Speech resource > Keys and Endpoint
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Pixo's voice (a child voice, American English)
AZURE_SPEECH_VOICE=en-US-AnaNeural
