{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixo.local/protocol/v1/content/session.schema.json",
  "title": "units/<unit>/s<n>.yaml: one session, in 7 fixed steps",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "unit",
    "title",
    "words",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^u[1-9][0-9]*-s[1-9][0-9]*$"
    },
    "unit": {
      "type": "string",
      "pattern": "^u[1-9][0-9]*-[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string"
    },
    "words": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "new words taught in this session"
    },
    "review": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "earlier words practised again"
    },
    "duration_min": {
      "type": "integer",
      "minimum": 5,
      "maximum": 15
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hello",
        "song",
        "review",
        "new",
        "game",
        "catchup",
        "bye"
      ],
      "properties": {
        "hello": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "song": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "review": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "new": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "game": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "catchup": {
          "type": "array",
          "maxItems": 0,
          "description": "generated by the engine from the words not yet validated"
        },
        "bye": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    }
  },
  "$defs": {
    "face": {
      "enum": [
        "idle",
        "talking",
        "listening",
        "thinking",
        "happy",
        "celebrate",
        "encourage",
        "surprised",
        "sleeping"
      ]
    },
    "gesture": {
      "enum": [
        "wave",
        "thumbs_up",
        "thumbs_down",
        "count_1",
        "count_2",
        "count_3",
        "count_4",
        "count_5",
        "point",
        "point_head",
        "point_eyes",
        "point_nose",
        "point_mouth",
        "point_ears",
        "show_hands",
        "point_feet",
        "clap",
        "hands_up",
        "high_five"
      ]
    },
    "action": {
      "type": "object",
      "description": "exactly one action: its name, then its fields",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "say": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "phrase": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*$",
              "description": "a category of phrases.yaml"
            },
            "face": {
              "$ref": "#/$defs/face"
            },
            "gesture": {
              "$ref": "#/$defs/gesture"
            }
          },
          "oneOf": [
            {
              "required": [
                "text"
              ],
              "not": {
                "required": [
                  "phrase"
                ]
              }
            },
            {
              "required": [
                "phrase"
              ],
              "not": {
                "required": [
                  "text"
                ]
              }
            }
          ]
        },
        "show": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            },
            "face": {
              "$ref": "#/$defs/face"
            },
            "gesture": {
              "$ref": "#/$defs/gesture"
            },
            "layout": {
              "enum": [
                "full",
                "with_pixo"
              ]
            }
          },
          "required": [
            "image"
          ]
        },
        "ask_say": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "word": {
              "type": "string"
            },
            "prompt": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*$",
              "description": "a category of phrases.yaml"
            }
          },
          "required": [
            "word",
            "prompt"
          ]
        },
        "ask_touch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "pattern": "^[a-z][a-z_]*$",
              "description": "a category of phrases.yaml"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 2,
              "maxItems": 4,
              "uniqueItems": true
            },
            "answer": {
              "type": "string"
            },
            "rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [
            "prompt",
            "options",
            "answer"
          ]
        },
        "sing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "song": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "required": [
            "song"
          ]
        },
        "video": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]*$"
            }
          },
          "required": [
            "video"
          ]
        },
        "celebrate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "gesture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gesture": {
              "$ref": "#/$defs/gesture"
            },
            "face": {
              "$ref": "#/$defs/face"
            }
          },
          "required": [
            "gesture"
          ]
        }
      }
    }
  }
}
